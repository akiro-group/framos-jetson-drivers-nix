From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] rtl8822ce: fix bogus null check on lock address

GCC 14 promotes -Waddress to an error under the -Werror inherited from
the top-level nvidia-oot Makefile.  The condition `&psta->lock != NULL`
is always true (address of a struct member is never null), so the if is
dead code.  Remove it, leaving the unconditional call that was always
executed.

diff --git a/source/nvidia-oot/drivers/net/wireless/realtek/rtl8822ce/core/rtw_sta_mgt.c b/source/nvidia-oot/drivers/net/wireless/realtek/rtl8822ce/core/rtw_sta_mgt.c
--- a/source/nvidia-oot/drivers/net/wireless/realtek/rtl8822ce/core/rtw_sta_mgt.c
+++ b/source/nvidia-oot/drivers/net/wireless/realtek/rtl8822ce/core/rtw_sta_mgt.c
@@ -390,8 +390,7 @@
 void rtw_mfree_stainfo(struct sta_info *psta)
 {

-	if (&psta->lock != NULL)
-		_rtw_spinlock_free(&psta->lock);
+	_rtw_spinlock_free(&psta->lock);

 	_rtw_free_sta_xmit_priv_lock(&psta->sta_xmitpriv);
 	_rtw_free_sta_recv_priv_lock(&psta->sta_recvpriv);
