From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] nvidia-oot: ASoC: use asoc_simple_* API unconditionally

The NV_ASOC_SIMPLE_RENAMED_SIMPLE conftest probe compiles against the
build host's kernel headers rather than the target NixOS kernel headers,
so it incorrectly detects the Linux 6.7 simple_util_* rename on an
Ubuntu 24.04 builder. The target kernel is 5.15, which only has the
original asoc_simple_* names.

Remove all NV_ASOC_SIMPLE_RENAMED_SIMPLE guards from
tegra_asoc_machine.c and tegra_codecs.c, keeping only the asoc_simple_*
code paths.

diff --git a/source/nvidia-oot/sound/soc/tegra/tegra_asoc_machine.c b/source/nvidia-oot/sound/soc/tegra/tegra_asoc_machine.c
--- a/source/nvidia-oot/sound/soc/tegra/tegra_asoc_machine.c
+++ b/source/nvidia-oot/sound/soc/tegra/tegra_asoc_machine.c
@@ -498,32 +498,18 @@
 		if (of_property_read_string(link_node,
 					    "link-name",
 					    &dai_link->name)) {
-#if defined(NV_ASOC_SIMPLE_RENAMED_SIMPLE) /* Linux 6.7 */
-			ret = simple_util_set_dailink_name(
-				&pdev->dev, dai_link, "%s-%d",
-				"tegra-dlink", link_count);
-#else
 			ret = asoc_simple_set_dailink_name(
 				&pdev->dev, dai_link, "%s-%d",
 				"tegra-dlink", link_count);
-#endif
 			if (ret < 0)
 				goto cleanup;
 		}
-
-#if defined(NV_ASOC_SIMPLE_RENAMED_SIMPLE) /* Linux 6.7 */
-		simple_util_parse_daifmt(&pdev->dev, link_node, codec,
-					 NULL, &dai_link->dai_fmt);

-		simple_util_canonicalize_platform(dai_link->platforms,
-						  dai_link->cpus);
-#else
 		asoc_simple_parse_daifmt(&pdev->dev, link_node, codec,
 					 NULL, &dai_link->dai_fmt);

 		asoc_simple_canonicalize_platform(dai_link->platforms,
 						  dai_link->cpus);
-#endif

 		of_property_read_u32(link_node, "link-type",
 				     &link_type);
@@ -596,11 +582,7 @@
 	struct device_node *node = card->dev->of_node;
 	int ret;

-#if defined(NV_ASOC_SIMPLE_RENAMED_SIMPLE) /* Linux 6.7 */
-	ret = simple_util_parse_card_name(card, PREFIX);
-#else
 	ret = asoc_simple_parse_card_name(card, PREFIX);
-#endif
 	if (ret < 0)
 		return ret;

diff --git a/source/nvidia-oot/sound/soc/tegra/tegra_codecs.c b/source/nvidia-oot/sound/soc/tegra/tegra_codecs.c
--- a/source/nvidia-oot/sound/soc/tegra/tegra_codecs.c
+++ b/source/nvidia-oot/sound/soc/tegra/tegra_codecs.c
@@ -22,13 +22,8 @@
 static int tegra_audio_dai_init(struct snd_soc_pcm_runtime *rtd)
 {
 	/* Used for audio graph based sound cards only */
-#if defined(NV_ASOC_SIMPLE_RENAMED_SIMPLE) /* Linux 6.7 */
 	if (rtd->card->component_chaining)
-		return simple_util_dai_init(rtd);
-#else
-	if (rtd->card->component_chaining)
 		return asoc_simple_dai_init(rtd);
-#endif

 	return 0;
 }
