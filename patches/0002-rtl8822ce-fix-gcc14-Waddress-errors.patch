From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] rtl8822ce: fix -Waddress errors with GCC 14

GCC 14 promotes -Waddress to an error under -Werror inherited from the
top-level nvidia-oot Makefile.  The phydm subsystem alone has ~20 sites
using the same always-true pointer idiom (array element used as a null
check, address of struct member compared to NULL).

Rather than patching each site individually, suppress -Waddress for the
entire driver via EXTRA_CFLAGS in its Makefile.  This is consistent with
the existing -Wno-unused-variable, -Wno-missing-prototypes, and
-Wno-date-time suppressions already present and is the standard approach
for imported vendor code in the kernel build system.

diff --git a/source/nvidia-oot/drivers/net/wireless/realtek/rtl8822ce/Makefile b/source/nvidia-oot/drivers/net/wireless/realtek/rtl8822ce/Makefile
--- a/source/nvidia-oot/drivers/net/wireless/realtek/rtl8822ce/Makefile
+++ b/source/nvidia-oot/drivers/net/wireless/realtek/rtl8822ce/Makefile
@@ -20,6 +20,7 @@
 ifeq ($(GCC_VER_49),1)
 EXTRA_CFLAGS += -Wno-date-time	# Fix compile error && warning on gcc 4.9 and later
 endif
+EXTRA_CFLAGS += -Wno-address	# Suppress always-true pointer comparisons in vendor code (GCC 14)

 SOURCETREE = $(srctree.nvidia-oot)/drivers/net/wireless/realtek/rtl8822ce
 EXTRA_CFLAGS += -I$(SOURCETREE)/include
