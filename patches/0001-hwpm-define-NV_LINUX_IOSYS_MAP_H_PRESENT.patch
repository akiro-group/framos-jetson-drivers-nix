From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] hwpm: define NV_LINUX_IOSYS_MAP_H_PRESENT for nixpkgs kernel

NV_LINUX_IOSYS_MAP_H_PRESENT is used as a guard throughout the hwpm and
nvidia-oot drivers to select between struct iosys_map (renamed from
dma_buf_map) and the old struct dma_buf_map fallback. The macro is never
emitted by the conftest build system — it is an orphaned guard.

The kernel packaged in nixpkgs carries the iosys-map rename, so define
the macro unconditionally in the hwpm Makefile and remove the now-dead
dma-buf-map.h fallback branches from mem_mgmt_utils.h and align the
version-code guards in mem_mgmt_utils.c to use the same macro.

diff --git a/source/hwpm/drivers/tegra/hwpm/Makefile b/source/hwpm/drivers/tegra/hwpm/Makefile
--- a/source/hwpm/drivers/tegra/hwpm/Makefile
+++ b/source/hwpm/drivers/tegra/hwpm/Makefile
@@ -20,6 +20,7 @@
 # For OOT builds, set required config flags
 ifeq ($(CONFIG_TEGRA_OOT_MODULE),m)
 CONFIG_TEGRA_HWPM_OOT := y
+ccflags-y += -DNV_LINUX_IOSYS_MAP_H_PRESENT
 ccflags-y += -DCONFIG_TEGRA_HWPM_OOT

 CONFIG_TEGRA_FUSE_UPSTREAM := y
diff --git a/source/hwpm/drivers/tegra/hwpm/os/linux/mem_mgmt_utils.h b/source/hwpm/drivers/tegra/hwpm/os/linux/mem_mgmt_utils.h
--- a/source/hwpm/drivers/tegra/hwpm/os/linux/mem_mgmt_utils.h
+++ b/source/hwpm/drivers/tegra/hwpm/os/linux/mem_mgmt_utils.h
@@ -23,11 +23,7 @@
 #include <linux/version.h>
 #if defined(NV_LINUX_IOSYS_MAP_H_PRESENT)
 #include <linux/iosys-map.h>
-#else
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 11, 0)
-#include <linux/dma-buf-map.h>
 #endif
-#endif

 /* This macro is copy of TEGRA_SOC_HWPM_MEM_BYTES_INVALID */
 #define TEGRA_HWPM_MEM_BYTES_INVALID	0xffffffff
@@ -53,11 +49,7 @@
 	void *mem_bytes_kernel;
 #if defined(NV_LINUX_IOSYS_MAP_H_PRESENT)
 	struct iosys_map mem_bytes_map;
-#else
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 11, 0)
-	struct dma_buf_map mem_bytes_map;
 #endif
-#endif
 };

 struct tegra_hwpm_allowlist_map {
diff --git a/source/hwpm/drivers/tegra/hwpm/os/linux/mem_mgmt_utils.c b/source/hwpm/drivers/tegra/hwpm/os/linux/mem_mgmt_utils.c
--- a/source/hwpm/drivers/tegra/hwpm/os/linux/mem_mgmt_utils.c
+++ b/source/hwpm/drivers/tegra/hwpm/os/linux/mem_mgmt_utils.c
@@ -93,7 +93,7 @@
 	struct tegra_soc_hwpm_alloc_pma_stream *alloc_pma_stream)
 {
 	struct tegra_hwpm_os_linux *hwpm_linux = NULL;
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 11, 0)
+#if defined(NV_LINUX_IOSYS_MAP_H_PRESENT)
 	int err = 0;
 #endif

@@ -130,7 +130,7 @@
 	hwpm->mem_mgmt->mem_bytes_buf_va =
 		sg_dma_address(hwpm->mem_mgmt->mem_bytes_sgt->sgl);

-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 11, 0)
+#if defined(NV_LINUX_IOSYS_MAP_H_PRESENT)
 	/*
 	 * Kernel version 5.11 and above introduces dma_buf_map structure
 	 * (called iosys_map in versions later than 5.18).
@@ -188,7 +188,7 @@
 	hwpm->mem_mgmt->stream_dma_buf = NULL;

 	if (hwpm->mem_mgmt->mem_bytes_kernel) {
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 11, 0)
+#if defined(NV_LINUX_IOSYS_MAP_H_PRESENT)
 		dma_buf_vunmap(hwpm->mem_mgmt->mem_bytes_dma_buf,
 			       &hwpm->mem_mgmt->mem_bytes_map);
 #else
