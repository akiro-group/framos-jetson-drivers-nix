From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Fix conftest and include paths for NixOS split kernel tree

The NixOS kernel package uses a split source/build tree.  Three distinct
problems arise:

1. source/Makefile passes NV_KERNEL_SOURCES=$(KERNEL_HEADERS) (the build
   tree) to conftest.sh.  conftest.sh derives SOURCE_ARCH_HEADERS from
   $SOURCES/arch/$ARCH/include, but the NixOS build tree has no arch
   headers there — they live only in the source tree.  Every probe that
   transitively includes an arch header (cpufeature.h, seqlock.h, …)
   fails to compile, causing inverted results: "functions" probes emit
   #define (absent) instead of #undef (present), and vice-versa for
   "types" probes.  Fix: pass NV_KERNEL_SOURCES=$(KERNEL_SOURCE).

2. The -E -M header presence test for linux/iosys-map.h fails for the
   same reason.  Hard-code the correct result since the header is
   present in linux-5.15 and the probe cannot be made reliable without
   a deeper change to test_header_presence.

3. The tegra-virt-alt Makefile uses $(overlay)/$(src) to build include
   paths.  $(overlay) is undefined everywhere, and on NixOS $(src) :=
   $(obj) is a path relative to $(KERNEL_OUTPUT) rather than an
   absolute path into the module source tree, so the directory is not
   found.  Replace both occurrences with $(srctree.nvidia-oot), which
   is always set correctly by source/Makefile.

diff --git a/source/Makefile b/source/Makefile
--- a/source/Makefile
+++ b/source/Makefile
@@ -42,7 +42,7 @@
 	$(MAKE) -j $(NPROC) ARCH=arm64 \
 		src=$(NVIDIA_CONFTEST)/nvidia obj=$(NVIDIA_CONFTEST)/nvidia \
 		CC=$(CROSS_COMPILE)gcc LD=$(CROSS_COMPILE)ld \
-		NV_KERNEL_SOURCES=$(KERNEL_HEADERS) \
+		NV_KERNEL_SOURCES=$(KERNEL_SOURCE) \
 		NV_KERNEL_OUTPUT=$(KERNEL_OUTPUT) \
 		-f $(NVIDIA_CONFTEST)/nvidia/Makefile
 endif

diff --git a/source/nvidia-oot/scripts/conftest/conftest.sh b/source/nvidia-oot/scripts/conftest/conftest.sh
--- a/source/nvidia-oot/scripts/conftest/conftest.sh
+++ b/source/nvidia-oot/scripts/conftest/conftest.sh
@@ -67,6 +67,17 @@ test_header_presence() {

     file="$1"
     file_define=NV_`echo $file | tr '/.\-a-z' '___A-Z'`_PRESENT
+
+    # The NixOS kernel's split source/build tree causes the -E -M header
+    # presence probe to fail for headers whose transitive includes pull in
+    # arch headers not present in the build tree.  Hard-code the result for
+    # linux/iosys-map.h which is present in linux-5.15 and later.
+    case "$file" in
+        linux/iosys-map.h)
+            echo "#define $file_define"
+            return
+        ;;
+    esac

     CODE="#include <$file>"

diff --git a/source/nvidia-oot/sound/soc/tegra-virt-alt/Makefile b/source/nvidia-oot/sound/soc/tegra-virt-alt/Makefile
--- a/source/nvidia-oot/sound/soc/tegra-virt-alt/Makefile
+++ b/source/nvidia-oot/sound/soc/tegra-virt-alt/Makefile
@@ -4,8 +4,8 @@
 GCOV_PROFILE := y

 subdir-ccflags-y += -Werror
-ccflags-y += -I$(overlay)/$(src)/../tegra-virt-alt/include/
-ccflags-y += -I$(overlay)/$(src)/../codecs
+ccflags-y += -I$(srctree.nvidia-oot)/sound/soc/tegra-virt-alt/include/
+ccflags-y += -I$(srctree.nvidia-oot)/sound/soc/codecs
 ccflags-y += -I$(srctree.nvidia-oot)/sound/soc/tegra-virt-alt/nvaudio_ivc/

 # Tegra platform Support
